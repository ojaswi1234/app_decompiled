    const-string v0, "\n\u0010sa_Fitness.proto\u0012\u0002SA\u001a\u000fsa_nanopb.proto\u001a\u000fsa_Common.proto\u001a\u0011sa_Sporting.proto\"\u00b7\r\n\tSEFitness\u0012.\n\u000ffitness_type_id\u0018\u0001 \u0001(\u000b2\u0013.SA.SEFitnessTypeIdH\u0000\u0012:\n\u0014fitness_type_id_list\u0018\u0002 \u0001(\u000b2\u001a.SA.SEFitnessTypeId.SEListH\u0000\u0012\u001a\n\tsport_ids\u0018\u0003 \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004H\u0000\u0012%\n\ndaily_data\u0018\u0004 \u0001(\u000b2\u000f.SA.SEDailyDataH\u0000\u0012%\n\nsleep_data\u0018\u0005 \u0001(\u000b2\u000f.SA.SESleepDataH\u0000\u0012C\n\u001acontinuous_heart_rate_data\u0018\u0006 \u0001(\u000b2\u001d.SA.SEContinuousHeartRateDataH\u0000\u0012=\n\u0017offline_heart_rate_data\u0018\u0007 \u0001(\u000b2\u001a.SA.SEOfflineHeartRateDataH\u0000\u0012G\n\u001ccontinuous_blood_oxygen_data\u0018\u0008 \u0001(\u000b2\u001f.SA.SEContinuousBloodOxygenDataH\u0000\u0012A\n\u0019offline_blood_oxygen_data\u0018\t \u0001(\u000b2\u001c.SA.SEOfflineBloodOxygenDataH\u0000\u0012@\n\u0018continuous_pressure_data\u0018\n \u0001(\u000b2\u001c.SA.SEContinuousPressureDataH\u0000\u0012:\n\u0015offline_pressure_data\u0018\u000b \u0001(\u000b2\u0019.SA.SEOfflinePressureDataH\u0000\u0012F\n\u001bcontinuous_temperature_data\u0018\u000c \u0001(\u000b2\u001f.SA.SEContinuousTemperatureDataH\u0000\u0012@\n\u0018offline_temperature_data\u0018\r \u0001(\u000b2\u001c.SA.SEOfflineTemperatureDataH\u0000\u0012>\n\u0017effective_standing_data\u0018\u000e \u0001(\u000b2\u001b.SA.SEEffectiveStandingDataH\u0000\u0012<\n\u0016activity_duration_data\u0018\u000f \u0001(\u000b2\u001a.SA.SEActivityDurationDataH\u0000\u00120\n\u0010offline_ecg_data\u0018\u0010 \u0001(\u000b2\u0014.SA.SEOfflineEcgDataH\u0000\u0012>\n\u0017examination_record_data\u0018\u0011 \u0001(\u000b2\u001b.SA.SEExaminationRecordDataH\u0000\u0012F\n\u001egomore_overalldaymovement_data\u0018\u0012 \u0001(\u000b2\u001c.SA.SEOverallDayMovementDataH\u0000\u0012=\n\u0018gomore_sleep_result_data\u0018\u0013 \u0001(\u000b2\u0019.SA.SERingSleepResultDataH\u0000\u0012@\n\u001egomore_sleepnap_data_list_data\u0018\u0014 \u0001(\u000b2\u0016.SA.SERingSleepNapDataH\u0000\u0012>\n\u0019gomore_healthy_score_data\u0018\u0015 \u0001(\u000b2\u0019.SA.SERingHealthScoreDataH\u0000\u0012J\n%gomore_today_activity_indicators_data\u0018\u0016 \u0001(\u000b2\u0019.SA.SETodayActiveTypeDataH\u0000\u0012K\n!gomore_today_respiratoryrate_data\u0018\u0017 \u0001(\u000b2\u001e.SA.SETodayRespiratoryRateDataH\u0000\u0012B\n\u001dgomore_auto_active_sport_data\u0018\u0018 \u0001(\u000b2\u0019.SA.SEAutoActiveSportDataH\u0000\u00128\n\u0017gomore_bodybattery_data\u0018\u0019 \u0001(\u000b2\u0015.SA.SEBodyBatteryDataH\u0000\u0012A\n\u001cgomore_stress_detection_data\u0018\u001a \u0001(\u000b2\u0019.SA.SEStressDetectionDataH\u0000\u0012,\n\u000bbatteryData\u0018\u001b \u0001(\u000b2\u0015.SA.SERingBatteryDataH\u0000\u00120\n\u0010drink_water_data\u0018\u001c \u0001(\u000b2\u0014.SA.SEDrinkWaterDataH\u0000B\t\n\u0007payload\"\u00b9\t\n\u000fSEFitnessTypeId\u0012\u001f\n\u0004time\u0018\u0001 \u0002(\u000b2\n.SA.SETimeB\u0005\u0092?\u00028 \u0012$\n\u0015fitness_function_type\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0008\u0012P\n\u0018fitness_data_offset_list\u0018\u0003 \u0001(\u000b2..SA.SEFitnessTypeId.SEFitnessOffsetType.SEList\u001a2\n\u0006SEList\u0012(\n\u0004list\u0018\u0001 \u0003(\u000b2\u0013.SA.SEFitnessTypeIdB\u0005\u0092?\u0002\u0018\u0004\u001a\u00d6\u0001\n\u0013SEFitnessOffsetType\u0012\u0010\n\u0008off_flag\u0018\u0001 \u0002(\u0008\u0012!\n\u0012power_off_rtc_time\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028 \u0012\"\n\u0013phone_sync_rtc_time\u0018\u0003 \u0002(\rB\u0005\u0092?\u00028 \u0012\u001e\n\u000foff_second_time\u0018\u0004 \u0002(\rB\u0005\u0092?\u00028 \u001aF\n\u0006SEList\u0012<\n\u0004list\u0018\u0001 \u0003(\u000b2\'.SA.SEFitnessTypeId.SEFitnessOffsetTypeB\u0005\u0092?\u0002\u0018\u0004\"\u00ff\u0005\n\u0015SEFitnessFunctionType\u0012\u000e\n\nDAILY_DATA\u0010\u0000\u0012\u000e\n\nSLEEP_DATA\u0010\u0001\u0012\u001e\n\u001aCONTINUOUS_HEART_RATE_DATA\u0010\u0002\u0012\u001b\n\u0017OFFLINE_HEART_RATE_DATA\u0010\u0003\u0012 \n\u001cCONTINUOUS_BLOOD_OXYGEN_DATA\u0010\u0004\u0012\u001d\n\u0019OFFLINE_BLOOD_OXYGEN_DATA\u0010\u0005\u0012\u001c\n\u0018CONTINUOUS_PRESSURE_DATA\u0010\u0006\u0012\u0019\n\u0015OFFLINE_PRESSURE_DATA\u0010\u0007\u0012\u001f\n\u001bCONTINUOUS_TEMPERATURE_DATA\u0010\u0008\u0012\u001c\n\u0018OFFLINE_TEMPERATURE_DATA\u0010\t\u0012\u0014\n\u0010OFFLINE_ECG_DATA\u0010\n\u0012\u001b\n\u0017EFFECTIVE_STANDING_DATA\u0010\u000b\u0012\u001a\n\u0016ACTIVITY_DURATION_DATA\u0010\u000c\u0012\u001b\n\u0017EXAMINATION_RECORD_DATA\u0010\r\u0012\'\n#GOMORE_ALG_ACTIVITY_INDICATORS_DATA\u0010\u000e\u0012 \n\u001cGOMORE_ALG_SLEEP_RESULT_DATA\u0010\u000f\u0012\u001d\n\u0019GOMORE_ALG_Sleep_Nap_Data\u0010\u0010\u0012$\n GOMORE_ALG_HEALTH_SCOREDATA_DATA\u0010\u0011\u0012\u001d\n\u0019GOMORE_ALG_SEDENTARY_DATA\u0010\u0012\u0012#\n\u001fGOMORE_ALG_RESPIRATORYRATE_DATA\u0010\u0013\u0012\u001d\n\u0019GOMORE_ALG_AUTOSPORT_DATA\u0010\u0014\u0012\u001f\n\u001bGOMORE_ALG_BODYBATTERY_DATA\u0010\u0015\u0012#\n\u001fGOMORE_ALG_STRESSDETECTION_DATA\u0010\u0016\u0012\u0015\n\u0011RING_BATTERY_DATA\u0010\u0017\u0012\u0014\n\u0010DRINK_WATER_DATA\u0010\u0018\"\u00a4\u0004\n\u000bSEDailyData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u0012\u001e\n\u000fsteps_frequency\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u0019\n\nsteps_data\u0018\u0003 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012!\n\u0012distance_frequency\u0018\u0004 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001c\n\rdistance_data\u0018\u0005 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012 \n\u0011calorie_frequency\u0018\u0006 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001b\n\u000ccalorie_data\u0018\u0007 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012\u0017\n\u0008HBA_data\u0018\u0008 \u0001(\rB\u0005\u0092?\u00028\u0010\u0012\u001f\n\u0010today_steps_data\u0018\t \u0001(\rB\u0005\u0092?\u00028 \u0012!\n\u0012today_calorie_data\u0018\n \u0001(\rB\u0005\u0092?\u00028 \u0012\u001f\n\u0010today_sleep_data\u0018\u000b \u0001(\rB\u0005\u0092?\u00028\u0010\u0012&\n\u0017today_oura_calorie_data\u0018\u000c \u0001(\rB\u0005\u0092?\u00028 \u0012\'\n\u0018today_sport_calorie_data\u0018\r \u0001(\rB\u0005\u0092?\u00028 \u0012-\n\u001etoday_oura_calorie_hourly_data\u0018\u000e \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012.\n\u001ftoday_sport_calorie_hourly_data\u0018\u000f \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004\"\u00b1\u0008\n\u000bSESleepData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u0012$\n\u0015start_sleep_timestamp\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028 \u0012\"\n\u0013end_sleep_timestamp\u0018\u0003 \u0002(\rB\u0005\u0092?\u00028 \u0012\u001d\n\u000esleep_duration\u0018\u0004 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001a\n\u000bsleep_score\u0018\u0005 \u0002(\rB\u0005\u0092?\u00028\u0008\u0012\u0019\n\nawake_time\u0018\u0006 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012$\n\u0015awake_time_percentage\u0018\u0007 \u0002(\rB\u0005\u0092?\u00028\u0008\u0012\u001f\n\u0010light_sleep_time\u0018\u0008 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012*\n\u001blight_sleep_time_percentage\u0018\t \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001e\n\u000fdeep_sleep_time\u0018\n \u0002(\rB\u0005\u0092?\u00028\u0010\u0012)\n\u001adeep_sleep_time_percentage\u0018\u000b \u0002(\rB\u0005\u0092?\u00028\u0010\u0012&\n\u0017rapid_eye_movement_time\u0018\u000c \u0001(\rB\u0005\u0092?\u00028\u0010\u00121\n\"rapid_eye_movement_time_percentage\u0018\r \u0001(\rB\u0005\u0092?\u00028\u0010\u0012T\n\u001csleep_distribution_data_list\u0018\u000e \u0002(\u000b2..SA.SESleepData.SESleepDistributionData.SEList\u0012/\n\nsleep_type\u0018\u000f \u0001(\u000e2\u001b.SA.SESleepData.SESleepType\u0012\u001d\n\u0015sleep_readiness_score\u0018\u0010 \u0001(\u0002\u001a\u00e1\u0002\n\u0017SESleepDistributionData\u0012\u001e\n\u000fstart_timestamp\u0018\u0001 \u0002(\rB\u0005\u0092?\u00028 \u0012\u001d\n\u000esleep_duration\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012`\n\u0017sleep_distribution_type\u0018\u0003 \u0002(\u000e2?.SA.SESleepData.SESleepDistributionData.SESleepDistributionType\u001aF\n\u0006SEList\u0012<\n\u0004list\u0018\u0001 \u0003(\u000b2\'.SA.SESleepData.SESleepDistributionDataB\u0005\u0092?\u0002\u0018\u0004\"]\n\u0017SESleepDistributionType\u0012\t\n\u0005AWAKE\u0010\u0000\u0012\u000f\n\u000bLIGHT_SLEEP\u0010\u0001\u0012\u000e\n\nDEEP_SLEEP\u0010\u0002\u0012\u0016\n\u0012RAPID_EYE_MOVEMENT\u0010\u0003\"1\n\u000bSESleepType\u0012\u0011\n\rDAYTIME_SLEEP\u0010\u0000\u0012\u000f\n\u000bNIGHT_SLEEP\u0010\u0001\"\u00e0\u0002\n\u0019SEContinuousHeartRateData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u0012.\n\u001fcontinuous_heart_rate_frequency\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001e\n\u000fheart_rate_data\u0018\u0003 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012#\n\u0014heart_rate_max_value\u0018\u0004 \u0001(\rB\u0005\u0092?\u00028\u0008\u0012#\n\u0014heart_rate_min_value\u0018\u0005 \u0001(\rB\u0005\u0092?\u00028\u0008\u0012\'\n\u0018resting_heart_rate_value\u0018\u0006 \u0001(\rB\u0005\u0092?\u00028\u0008\u0012(\n\u0019heart_rate_hour_max_value\u0018\u0007 \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012(\n\u0019heart_rate_hour_min_value\u0018\u0008 \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004\"\u0080\u0001\n\rSEMeasureData\u0012 \n\u0011measure_timestamp\u0018\u0001 \u0002(\rB\u0005\u0092?\u00028 \u0012\u001b\n\u000cmeasure_data\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u001a0\n\u0006SEList\u0012&\n\u0004list\u0018\u0001 \u0003(\u000b2\u0011.SA.SEMeasureDataB\u0005\u0092?\u0002\u0018\u0004\"{\n\u0016SEOfflineHeartRateData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u00123\n\u0011measure_data_list\u0018\u0002 \u0002(\u000b2\u0018.SA.SEMeasureData.SEList\"\u00ba\u0002\n\u001bSEContinuousBloodOxygenData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u0012%\n\u0016blood_oxygen_frequency\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012 \n\u0011blood_oxygen_data\u0018\u0003 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012%\n\u0016blood_oxygen_max_value\u0018\u0004 \u0001(\rB\u0005\u0092?\u00028\u0008\u0012%\n\u0016blood_oxygen_min_value\u0018\u0005 \u0001(\rB\u0005\u0092?\u00028\u0008\u0012*\n\u001bblood_oxygen_hour_max_value\u0018\u0006 \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012*\n\u001bblood_oxygen_hour_min_value\u0018\u0007 \u0001(\u000cB\u0005\u0092?\u0002\u0018\u0004\"}\n\u0018SEOfflineBloodOxygenData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u00123\n\u0011measure_data_list\u0018\u0002 \u0002(\u000b2\u0018.SA.SEMeasureData.SEList\"\u00d9\u0001\n\u0018SEContinuousPressureData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u0012!\n\u0012pressure_frequency\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001c\n\rpressure_data\u0018\u0003 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\u0012&\n\u0017pressure_data_max_value\u0018\u0004 \u0001(\rB\u0005\u0092?\u00028\u0008\u0012&\n\u0017pressure_data_min_value\u0018\u0005 \u0001(\rB\u0005\u0092?\u00028\u0008\"z\n\u0015SEOfflinePressureData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u00123\n\u0011measure_data_list\u0018\u0002 \u0002(\u000b2\u0018.SA.SEMeasureData.SEList\"\u0092\u0001\n\u001bSEContinuousTemperatureData\u0012,\n\u000ffitness_type_id\u0018\u0001 \u0002(\u000b2\u0013.SA.SEFitnessTypeId\u0012$\n\u0015temperature_frequency\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0010\u0012\u001f\n\u0010temperature_data\u0018\u0003 \u0002(\u000cB\u0005\u0092?\u0002\u0018\u0004\"}\n\u0018SEOfflineTemperatureData\u0012,\n\u000ffitness_type_id\u