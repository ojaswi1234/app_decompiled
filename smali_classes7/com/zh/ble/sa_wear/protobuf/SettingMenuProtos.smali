02 \u0001(\r\u0012\"\n\u001asupport_max_schduler_habit\u0018\u0003 \u0001(\r\u0012%\n\u001dsupport_max_schduler_reminder\u0018\u0004 \u0001(\r\u0012\"\n\u001asupport_max_habit_time_set\u0018\u0005 \u0001(\r\"5\n\u000fSESchedulerType\u0012\t\n\u0005ALERT\u0010\u0000\u0012\t\n\u0005HABIT\u0010\u0001\u0012\u000c\n\u0008REMINDER\u0010\u0002B\t\n\u0007payload\"\u0097\u0001\n\u001aSESchedulerReminderResoult\u0012G\n\u0016schedule_reminder_type\u0018\u0001 \u0002(\u000e2\'.SA.SESchedulerReminder.SESchedulerType\u00120\n\u0008data_ist\u0018\u0002 \u0002(\u000b2\u001e.SA.SESchedulerDataList.SEList\"j\n\u0013SESchedulerDataList\u0012\n\n\u0002id\u0018\u0001 \u0002(\r\u0012\u000f\n\u0007resoult\u0018\u0002 \u0002(\u0008\u001a6\n\u0006SEList\u0012,\n\u0004list\u0018\u0001 \u0003(\u000b2\u0017.SA.SESchedulerDataListB\u0005\u0092?\u0002\u0018\u0004\"\u0084\u0001\n\u0007SEAlert\u0012\u0019\n\nalert_name\u0018\u0001 \u0002(\tB\u0005\u0092?\u0002\u0018\u0004\u0012%\n\nalert_time\u0018\u0002 \u0002(\u000b2\u0011.SA.SESettingTime\u0012\u001b\n\u000calert_repeat\u0018\u0003 \u0002(\rB\u0005\u0092?\u00028\u0008\u0012\u001a\n\u000bnotify_text\u0018\u0004 \u0002(\tB\u0005\u0092?\u0002\u0018\u0004\"b\n\u000eSEHabitTimeSet\u0012\u001f\n\u0004time\u0018\u0001 \u0002(\u000b2\u0011.SA.SESettingTime\u001a/\n\u0004List\u0012\'\n\u0004list\u0018\u0001 \u0003(\u000b2\u0012.SA.SEHabitTimeSetB\u0005\u0092?\u0002\u0018\u0004\"\u0092\u0001\n\u0007SEHabit\u0012\u0019\n\nhabit_name\u0018\u0001 \u0002(\tB\u0005\u0092?\u0002\u0018\u0004\u0012\u001b\n\u000calert_repeat\u0018\u0002 \u0002(\rB\u0005\u0092?\u00028\u0008\u00124\n\u0013habit_time_set_list\u0018\u0003 \u0002(\u000b2\u0017.SA.SEHabitTimeSet.List\u0012\u0019\n\nhabit_type\u0018\u0004 \u0001(\rB\u0005\u0092?\u00028\u0008\"\u00e2\u0001\n\nSEReminder\u0012\u001c\n\rreminder_name\u0018\u0001 \u0002(\tB\u0005\u0092?\u0002\u0018\u0004\u0012%\n\nstart_time\u0018\u0002 \u0002(\u000b2\u0011.SA.SESettingTime\u0012#\n\u0008end_time\u0018\u0003 \u0002(\u000b2