    const-string v0, "\n\u000fwear_aivs.proto\u001a\u000cnanopb.proto\"i\n\u0004Aivs\u00121\n\u0010instruction_list\u0018\u0001 \u0001(\u000b2\u0015.AivsInstruction.ListH\u0000\"#\n\u0006AivsID\u0012\u0019\n\u0015SYNC_INSTRUCTION_LIST\u0010\u0000B\t\n\u0007payload\"\u00c7\t\n\u000fAivsInstruction\u0012 \n\u000bresult_type\u0018\u0001 \u0002(\u000e2\u000b.ResultType\u0012\u0019\n\nsession_id\u0018\r \u0002(\rB\u0005\u0092?\u00028\u0008\u00120\n\u0010recognize_result\u0018\u0002 \u0001(\u000b2\u0016.SpeechRecognizeResult\u0012&\n\u000etemplate_toast\u0018\u0003 \u0001(\u000b2\u000e.TemplateToast\u0012*\n\u0010template_general\u0018\u0004 \u0001(\u000b2\u0010.TemplateGeneral\u0012,\n\u0011template_general2\u0018\u0005 \u0001(\u000b2\u0011.TemplateGeneral2\u0012*\n\u0010template_weather\u0018\u0006 \u0001(\u000b2\u0010.TemplateWeather\u0012,\n\u0011template_playinfo\u0018\u0007 \u0001(\u000b2\u0011.TemplatePlayInfo\u0012&\n\u000etemplate_lists\u0018\u0008 \u0001(\u000b2\u000e.TemplateLists\u00122\n\u0014template_switchpanel\u0018\t \u0001(\u000b2\u0014.TemplateSwitchPanel\u0012(\n\u000falerts_setalert\u0018\n \u0001(\u000b2\u000f.AlertsSetAlert\u00128\n\u0017speechsynthesizer_speak\u0018\u000b \u0001(\u000b2\u0017.SpeechSynthesizerSpeak\u0012,\n\u0010laucher_lauchapp\u0018\u000e \u0001(\u000b2\u0012.LauncherLaunchApp\u0012:\n\u0018template_switchpanellist\u0018\u000f \u0001(\u000b2\u0018.TemplateSwitchPanelList\u0012R\n$brightnesscontroller_ajustbrightness\u0018\u0010 \u0001(\u000b2$.BrightnessControllerAjustBrightness\u0012.\n\u0012system_setproperty\u0018\u0011 \u0001(\u000b2\u0012.SystemSetProperty\u00120\n\u0013application_operate\u0018\u0012 \u0001(\u000b2\u0013.ApplicationOperate\u0012B\n\u001calerts_deliveralertintention\u0018\u0013 \u0001(\u000b2\u001c.AlertsDeliverAlertIntention\u0012(\n\u000fmedia_errortype\u0018\u0014 \u0001(\u000e2\u000f.MediaErrorType\u0012(\n\u000fspeaker_setmute\u0018\u0015 \u0001(\u000b2\u000f.SpeakerSetMute\u0012,\n\u0011speaker_setvolu